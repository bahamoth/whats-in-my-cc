{
  // solution-style 루트 (create-vite 템플릿 관례) — 컴파일 옵션은
  // tsconfig.app.json(src)·tsconfig.node.json(vite.config.ts)이 소유한다.
  // baseUrl/paths 미러는 shadcn CLI 등 루트만 읽는 도구용 (shadcn vite 가이드).
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  }
}
