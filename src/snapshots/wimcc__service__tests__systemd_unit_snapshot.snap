[Unit]
Description=wimcc serve — local Claude Code observation

[Service]
ExecStart="/usr/local/bin/wimcc" "--db-path" "/data/wimcc.sqlite" "serve" "--bind" "127.0.0.1" "--port" "7878" "--auto-migrate"
